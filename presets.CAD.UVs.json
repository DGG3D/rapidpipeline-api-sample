{
  "presets": {
    "example_0_CAD-import_oc-culling": {
      "config": {
        "import": {
           "general": {
             "rotateZUp": false,
             "fixAnimationData": true,
             "normalmapYFlip": false
           },
           "CAD": {
             "tessellationResolution": "custom",
             "removeTJunctions": false,
             "sewTolerance":0.05,
             "maxSurfaceDeviation":0.03,
             "maxAngle":40,
             "maxEdgeLength":0
           },
           "discard": {
             "cameras": false,
             "lights": false,
             "animations": false,
             "morphTargets": false,
             "unusedUVs": false
           },
           "materials": {
             "undefinedDefaults": {
                 "baseColor": [1,1,1,1],
                 "metallic": 0,
                 "roughness": 0.5
              }
           }
         },
         "3dEdit": {
           "meshNormals": {
             "recomputeInputNormals": true,
             "hardAngleThreshold": 30.0,
             "computationMethod": "area"
           },
           "modelEdit": {
             "splitMultiMaterialMeshes": true
           },
           "materialEdit": {
             "materialReplacer": {
               "defaultMaterial": {
                 "generateUVs": {
                   "cubeUnwrap": {
                     "scale": 10.0,
                     "sourceSpace3D": "world"
                   }
                 }
               }
             }
           },
           "repair": {
             "vertexMerging":{
               "mergeDistance": {
                 "percentage": 0.01
               },
               "perMesh": false 
             },
             "windingOrder": {
               "visibilityMode": "default",
               "ignoreTransparency" : false,
               "perLump": true
             }
           }
         },
         "sceneGraphFlattening": {
           "method": "none",
           "preservedSceneDepth": 0
         },
         "meshCulling": {
           "occlusionCulling": {
             "perMesh": false,
             "quality": "default",
             "ignoreTransparency": false,
             "diffusion": "conservative",
             "runAfterDecimator": true,
             "sampleEdges": true,
             "perLumpDecision" : true,
             "lumpThreshold": 0.15
          },
           "smallFeatureCulling": {
             "sizeThreshold": {
               "percentage": 0.0
             },
             "runAfterDecimator": false
           }
        },
        "export": [
          {
            "preserveTextureFilenames": false,
            "reencodeTextures": "auto",
            "format": {
              "glb": {
                "geometryCompression": "none",
                "excludeTangents": true,
                "pbrMaterial": {
                  "separateOcclusionMap": false,
                  "excludePbrExtensions": false,
                  "forceDoubleSidedMaterials": false,
                  "forceUnlitMaterials": false,
                  "convertMetalRoughness": false,
                  "maxTextureResolution": {
                    "default": 2048
                  }
                }
              }
            }
          },
          {
            "preserveTextureFilenames": false,
            "reencodeTextures": "auto",
            "discard": {
              "unusedUVs": false
            },
            "trisToQuads" : {
                "enable" : true
            },
            "format": {
              "usdz": {
                "usdProfile": "generic",
                "usdUnits": "cm",
                "excludeTangents": true,
                "forceDoubleSidedMeshes": false,
                "usdPreviewSurface": {
                  "maxTextureResolution": {
                    "default": 2048
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
